# =============================================================================
# Aetherion Discord Bot — Configuration file (.env)
# =============================================================================
#
# INSTRUCTIONS:
#   1. Copy this file to `.env`  (or run `python scripts/configure_env.py`)
#   2. Fill in at least DISCORD_BOT_TOKEN and xAI authentication.
#   3. Use `python scripts/configure_env.py` for a guided, safe setup (recommended).
#
# This is the official clean template. All keys are UPPER_SNAKE_CASE.
# The bot (pydantic-settings) and the safe .env writer treat keys as
# case-insensitive, so they keep the original casing in your current file.
#
# Bot philosophy:
#   - "Let Grok be Grok": inject as little extra context as possible and trust
#     Grok's native abilities (long context, web_search, vision, personality).
#   - Secrets live only in .env or the OAuth token file (never in git).
#   - The web dashboard (/config) can edit SAFE settings only (never tokens).
#
# Required for the bot to start:
#   - DISCORD_BOT_TOKEN
#   - xAI auth: XAI_API_KEY (stable)  OR  OAuth login (experimental)
#
# Strongly recommended:
#   - ALLOWED_GUILD_IDS (server allowlist)
#   - GROK_AUTH_MODE (explicit)
#
# =============================================================================

# -----------------------------------------------------------------------------
# DISCORD (REQUIRED)
# -----------------------------------------------------------------------------
# Bot token. Get it at: https://discord.com/developers/applications
# (Bot > Token > Reset Token if needed)
DISCORD_BOT_TOKEN=

# Guild ID allowlist (servers). Strongly recommended in production.
# Format: comma-separated list OR compact JSON array.
# Examples:
#   ALLOWED_GUILD_IDS=123456789012345678,987654321098765432
#   ALLOWED_GUILD_IDS=[123456789012345678,987654321098765432]
# Empty = the bot will accept invites and run in ANY server
# (not recommended for security).
ALLOWED_GUILD_IDS=

# -----------------------------------------------------------------------------
# xAI / GROK AUTH
# -----------------------------------------------------------------------------
# --- Recommended (stable): classic API key ---
# Get your key at https://console.x.ai
XAI_API_KEY=

# Auth mode:
#   api_key  → always use XAI_API_KEY (recommended for most people, stable)
#   oauth    → require browser OAuth (SuperGrok / X Premium+). No XAI_API_KEY needed.
#   auto     → prefer a valid OAuth token if one exists (with refresh), fall back to XAI_API_KEY.
#              Best UX: log in once and mostly forget it.
GROK_AUTH_MODE=api_key

# --- Experimental OAuth (SuperGrok / X Premium+) ---
# Browser OAuth 2.0 + PKCE against accounts.x.ai (same flow as Hermes Agent).
# After setting GROK_AUTH_MODE=oauth or auto, run once:
#     groksito --login-oauth
#     (or answer "yes" when scripts/configure_env.py offers it)
#     `aetherion` is an alias of the same CLI.
#
# Full guide (SSH tunnel, Docker, --no-browser, --print-url-only,
# 403/tier fixes, invalid_grant, ports, etc.):
#   See GROK_OAUTH.md
#
# Real tokens are stored in ./oauth/xai_oauth_tokens.json (NEVER in .env).
# You can change the location if you want:
# GROK_OAUTH_PORT=56121
# GROK_OAUTH_TOKEN_FILE=./oauth/xai_oauth_tokens.json

# -----------------------------------------------------------------------------
# MODEL AND API BEHAVIOR
# -----------------------------------------------------------------------------
GROK_MODEL=grok-4.3

# Retries only for transient errors (429, 5xx, network). Auth/policy errors fail immediately.
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY_SECONDS=0.5
API_TIMEOUT_SECONDS=60.0
# Video generation uses a longer internal budget (~300s).

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Video generation (explicit Text-to-Video + Image-to-Video).
# Set false for cost control or during incidents.
ENABLE_VIDEO_GENERATION=true

# -----------------------------------------------------------------------------
# RECENT CONTEXT (light, high-signal summary)
# -----------------------------------------------------------------------------
# When the bot is mentioned or replied to, generate a short quality summary
# of recent channel messages and inject it. Separate from "proactive summarization".
ENABLE_RECENT_CONTEXT_SUMMARY=true
ENABLE_RECENT_CONTEXT=true          # legacy alias (prefer the one above)
RECENT_CONTEXT_MESSAGE_LIMIT=20
RECENT_CONTEXT_MAX_TOKENS=400

# -----------------------------------------------------------------------------
# PROACTIVE SUMMARIZATION (old-history compaction)
# -----------------------------------------------------------------------------
# Disabled by default. Grok's native context window is very large.
# Turn on only if you see excessive token use in very long threads.
SUMMARIZATION_ENABLED=false
SUMMARIZATION_THRESHOLD_TOKENS=6000

# -----------------------------------------------------------------------------
# CONTEXT AND CONVERSATION TUNING
# -----------------------------------------------------------------------------
# Dynamic context tiering: light injection for simple questions,
# richer when the conversation is complex. Strongly recommended.
CONTEXT_SMART_MODE=true

# On tool-continuation rounds, send the smallest tool list possible.
# One of the biggest token savers. Leave it on.
AGGRESSIVE_CONTINUATION_TOOL_MINIMIZATION=true

# Structured logs for tool decisions and cache effectiveness (low overhead).
LOG_TOOL_SELECTION=true
LOG_CACHE_METRICS=true

# -----------------------------------------------------------------------------
# TTS / AUDIO (xAI /v1/tts)
# -----------------------------------------------------------------------------
# Default voice and language for the voice/TTS tool.
# Available voices: eve (default, energetic), ara, rex, sal, leo
# Language: BCP-47 code. Use 'en' for English, 'auto' for mixed.
# The language parameter is REQUIRED by the xAI TTS endpoint.
TTS_DEFAULT_VOICE=eve
TTS_DEFAULT_LANGUAGE=en

# -----------------------------------------------------------------------------
# LIMITS AND THRESHOLDS (editable from the web dashboard)
# -----------------------------------------------------------------------------
# The following thresholds (and several others) are exposed for live editing via the web dashboard (/config).
# They are defined with full comments in the sections above. Do not duplicate values here.
# Examples of web-editable ones:
#   RECENT_CONTEXT_MESSAGE_LIMIT, RECENT_CONTEXT_MAX_TOKENS, SUMMARIZATION_THRESHOLD_TOKENS,
#   API_MAX_RETRIES, RECENT_CONTEXT_MESSAGE_LIMIT, etc.
# After web edits, restart the Discord bot process for changes to take effect.

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# INFO is recommended for production. DEBUG is noisy but useful while developing.
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# PERSISTENCE
# -----------------------------------------------------------------------------
# Short-term channel context (conversation state).
DATA_DIR=./data
# PANTSU_CONTEXT_FILE=   # (optional, legacy override)

# IMPORTANT NOTES
# -----------------------------------------------------------------------------
# - All keys are case-insensitive at runtime (pydantic-settings).
# - The safe writer (used by scripts/configure_env.py and the web UI):
#     * Updates existing keys in-place (case-insensitive lookup, keeps original casing)
#     * Collapses pre-existing duplicates of the key you are touching
#     * Only appends brand-new keys
#     * Always backups first + atomic write + critical-key verification
# - ALWAYS use `python scripts/configure_env.py` to create/repair .env (especially secrets).
# - After changing something from the web dashboard, restart the Discord bot process.
#
# Full OAuth guide (recommended if you want to try without an API key):
#   See GROK_OAUTH.md
#
# Useful commands after setup:
#   groksito --status
#   groksito --check
#   groksito --login-oauth
#   aetherion --status
#
# =============================================================================
